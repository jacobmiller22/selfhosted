# GitHub Personal Access Token (read-only repo access) for building private jacobmiller22/btcupdown
GITHUB_TOKEN=ghp_example_read_only_token
BTCUPDOWN_REF=main

# Initial Vixxy session cookie / JWT (vixy_session=... or raw JWT)
# Once bootstrapped, rotated tokens are persisted atomically to /data/vixxy_token_state.json
INITIAL_ACCESS_TOKEN=vixy_session=eyJ...

# Data Broker Retention & Polling Configuration
BROKER_RAW_RETENTION_DAYS=0
VIXXY_POLL_INTERVAL_MS=3000
VIXXY_JITTER_MS=250
VIXXY_HEARTBEAT_INTERVAL_SECS=30

# Kalshi Public Market Poller Configuration
KALSHI_ENABLE=true
KALSHI_BASE_URL=https://api.elections.kalshi.com/trade-api/v2
KALSHI_SERIES_TICKER=KXBTC15M
KALSHI_POLL_INTERVAL_MS=1000
KALSHI_SETTLE_POLL_INTERVAL_MS=2000
